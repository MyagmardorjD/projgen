services:
  app:
    build: .
    ports:
      - "8080:8080"
    environment:
      SERVICE_NAME: {{.Opt.Name}}
      APP_ENV: dev
      PORT: "8080"
      LOG_LEVEL: INFO
{{- if .HasDB}}
{{- if .Java}}
      DATABASE_URL: "{{.DB.JavaComposeURL}}"
      DATABASE_USER: ${DB_USER:-app}
      DATABASE_PASSWORD: ${DB_PASSWORD:-app}
{{- else}}
      DATABASE_URL: "{{.DB.ComposeURL}}"
{{- end}}
{{- end}}
{{- if .Auth}}
      # No default: put JWT_SECRET in .env (at least 32 bytes).
      JWT_SECRET: ${JWT_SECRET:?set JWT_SECRET in .env}
      JWT_ISSUER: ${JWT_ISSUER:-}
      JWT_AUDIENCE: ${JWT_AUDIENCE:-}
{{- end}}
{{- if .Redis}}
      REDIS_URL: redis://redis:6379/0
{{- end}}
{{- if .Observability}}
{{- if .Java}}
      TRACING_EXPORT_ENABLED: ${TRACING_EXPORT_ENABLED:-false}
      OTEL_EXPORTER_OTLP_TRACES_ENDPOINT: ${OTEL_EXPORTER_OTLP_TRACES_ENDPOINT:-http://localhost:4318/v1/traces}
{{- else}}
      OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT:-}
{{- end}}
{{- end}}
{{- if or .HasDB .Redis}}
    depends_on:
{{- if .HasDB}}
      db:
        condition: service_healthy
{{- end}}
{{- if .Redis}}
      redis:
        condition: service_healthy
{{- end}}
{{- end}}
{{- if eq .Opt.Database "postgresql"}}

  db:
    image: {{.DB.Image}}
    environment:
      POSTGRES_USER: ${DB_USER:-app}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-app}
      POSTGRES_DB: ${DB_NAME:-app}
    ports:
      - "5432:5432"
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 10
{{- else if eq .Opt.Database "mysql"}}

  db:
    image: {{.DB.Image}}
    environment:
      MYSQL_USER: ${DB_USER:-app}
      MYSQL_PASSWORD: ${DB_PASSWORD:-app}
      MYSQL_DATABASE: ${DB_NAME:-app}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-root}
    ports:
      - "3306:3306"
    volumes:
      - db-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 5s
      timeout: 3s
      retries: 20
{{- end}}
{{- if .Redis}}

  redis:
    image: {{.RedisImage}}
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
{{- end}}
{{- if .HasDB}}

volumes:
  db-data:
{{- end}}
