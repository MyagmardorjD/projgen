{{- /* Required variables every valid case sets; test values only. */ -}}
{{- $req := "" -}}
{{- if .HasDB}}{{$req = printf "%s\"DATABASE_URL\": \"test-dsn\", " $req}}{{end -}}
{{- if .Auth}}{{$req = printf "%s\"JWT_SECRET\": testSecret, " $req}}{{end -}}
{{- if .Redis}}{{$req = printf "%s\"REDIS_URL\": \"redis://localhost:6379/0\", " $req}}{{end -}}
{{- if .QPay}}{{$req = printf "%s\"QPAY_USERNAME\": \"test-user\", \"QPAY_PASSWORD\": \"test-password\", \"QPAY_CALLBACK_URL\": \"http://localhost:8080/payments/qpay\", \"QPAY_INVOICE_CODE\": \"TEST_INVOICE\", " $req}}{{end -}}
{{- if .Bonum}}{{$req = printf "%s\"BONUM_APP_SECRET\": \"test-secret\", \"BONUM_TERMINAL_ID\": \"test-terminal\", " $req}}{{end -}}
{{- if .Golomt}}{{$req = printf "%s\"GOLOMT_ECOMMERCE_SECRET\": \"test-secret\", \"GOLOMT_ECOMMERCE_TOKEN\": \"test-token\", " $req}}{{end -}}
package config

import (
	"strings"
	"testing"
)
{{- if .Auth}}

// testSecret is a throwaway value for tests only.
const testSecret = "test-secret-0123456789-0123456789"
{{- end}}

// valid returns the variables a valid configuration needs, with overrides
// given as key, value pairs.
func valid(kv ...string) map[string]string {
	env := map[string]string{ {{- $req -}} }
	for i := 0; i+1 < len(kv); i += 2 {
		env[kv[i]] = kv[i+1]
	}
	return env
}

func TestLoad(t *testing.T) {
	tests := []struct {
		name    string
		env     map[string]string
		wantErr string
		check   func(t *testing.T, c Config)
	}{
		{
			name: "defaults",
			env:  valid(),
			check: func(t *testing.T, c Config) {
				if c.Port != "8080" || c.Env != "dev" || c.ServiceName != "{{.Opt.Name}}" || c.LogLevel != "INFO" {
					t.Errorf("unexpected defaults: %+v", c)
				}
			},
		},
		{
			name: "overrides",
			env:  valid("PORT", "9090", "APP_ENV", "prod"),
			check: func(t *testing.T, c Config) {
				if c.Port != "9090" || c.Env != "prod" {
					t.Errorf("overrides not applied: %+v", c)
				}
			},
		},
		{
			name:    "port not a number",
			env:     valid("PORT", "http"),
			wantErr: "PORT",
		},
{{- if .HasDB}}
		{
			name:    "database url missing",
			env:     valid("DATABASE_URL", ""),
			wantErr: "DATABASE_URL",
		},
{{- end}}
{{- if .Migrations}}
		{
			name: "migrate on start by default",
			env:  valid(),
			check: func(t *testing.T, c Config) {
				if !c.MigrateOnStart {
					t.Error("MigrateOnStart should default to true")
				}
			},
		},
		{
			name: "migrate on start off",
			env:  valid("MIGRATE_ON_START", "false"),
			check: func(t *testing.T, c Config) {
				if c.MigrateOnStart {
					t.Error("MigrateOnStart should be false")
				}
			},
		},
		{
			name:    "migrate on start invalid",
			env:     valid("MIGRATE_ON_START", "maybe"),
			wantErr: "MIGRATE_ON_START",
		},
{{- end}}
{{- if .Auth}}
		{
			name:    "jwt secret missing",
			env:     valid("JWT_SECRET", ""),
			wantErr: "JWT_SECRET",
		},
		{
			name:    "jwt secret too short",
			env:     valid("JWT_SECRET", "short"),
			wantErr: "JWT_SECRET",
		},
		{
			name: "jwt issuer and audience",
			env:  valid("JWT_ISSUER", "https://id.example.com", "JWT_AUDIENCE", "api"),
			check: func(t *testing.T, c Config) {
				if c.JWTIssuer != "https://id.example.com" || c.JWTAudience != "api" {
					t.Errorf("issuer/audience not read: %q %q", c.JWTIssuer, c.JWTAudience)
				}
			},
		},
{{- end}}
{{- if .Redis}}
		{
			name:    "redis url missing",
			env:     valid("REDIS_URL", ""),
			wantErr: "REDIS_URL",
		},
{{- end}}
{{- if .QPay}}
		{
			name: "qpay sandbox by default",
			env:  valid(),
			check: func(t *testing.T, c Config) {
				if c.QPay.Endpoint != "https://merchant-sandbox.qpay.mn/v2" || c.QPay.Username != "test-user" {
					t.Errorf("unexpected qpay settings: endpoint %q, username %q", c.QPay.Endpoint, c.QPay.Username)
				}
			},
		},
		{
			name:    "qpay password missing",
			env:     valid("QPAY_PASSWORD", ""),
			wantErr: "QPAY_PASSWORD",
		},
		{
			name:    "qpay invoice code missing",
			env:     valid("QPAY_INVOICE_CODE", ""),
			wantErr: "QPAY_INVOICE_CODE",
		},
{{- end}}
{{- if .Bonum}}
		{
			name: "bonum sandbox by default",
			env:  valid(),
			check: func(t *testing.T, c Config) {
				if c.Bonum.Env != "sandbox" || c.Bonum.TerminalID != "test-terminal" {
					t.Errorf("unexpected bonum settings: env %q, terminal %q", c.Bonum.Env, c.Bonum.TerminalID)
				}
			},
		},
		{
			name:    "bonum env invalid",
			env:     valid("BONUM_ENV", "live"),
			wantErr: "BONUM_ENV",
		},
		{
			name:    "bonum app secret missing",
			env:     valid("BONUM_APP_SECRET", ""),
			wantErr: "BONUM_APP_SECRET",
		},
{{- end}}
{{- if .Golomt}}
		{
			name: "golomt ecommerce only",
			env:  valid(),
			check: func(t *testing.T, c Config) {
				if !c.Golomt.Ecommerce() || c.Golomt.SocialPay() {
					t.Errorf("want only eCommerce configured: %v %v", c.Golomt.Ecommerce(), c.Golomt.SocialPay())
				}
			},
		},
		{
			name: "golomt socialpay only",
			env: valid("GOLOMT_ECOMMERCE_TOKEN", "", "GOLOMT_SOCIALPAY_URL", "https://socialpay.example.mn",
				"GOLOMT_SOCIALPAY_TERMINAL", "test-terminal", "GOLOMT_SOCIALPAY_SECRET", "test-secret"),
			check: func(t *testing.T, c Config) {
				if c.Golomt.Ecommerce() || !c.Golomt.SocialPay() {
					t.Errorf("want only SocialPay configured: %v %v", c.Golomt.Ecommerce(), c.Golomt.SocialPay())
				}
			},
		},
		{
			name:    "golomt nothing configured",
			env:     valid("GOLOMT_ECOMMERCE_TOKEN", ""),
			wantErr: "GOLOMT_",
		},
{{- end}}
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			for _, k := range []string{"PORT", "APP_ENV", "SERVICE_NAME", "LOG_LEVEL", "DATABASE_URL", "MIGRATE_ON_START",
				"JWT_SECRET", "JWT_ISSUER", "JWT_AUDIENCE", "REDIS_URL"{{if .QPay}},
				"QPAY_USERNAME", "QPAY_PASSWORD", "QPAY_ENDPOINT", "QPAY_CALLBACK_URL", "QPAY_INVOICE_CODE", "QPAY_MERCHANT_ID"{{end}}{{if .Bonum}},
				"BONUM_ENV", "BONUM_APP_SECRET", "BONUM_TERMINAL_ID", "BONUM_CHECKSUM_KEY"{{end}}{{if .Golomt}},
				"GOLOMT_ECOMMERCE_URL", "GOLOMT_ECOMMERCE_SECRET", "GOLOMT_ECOMMERCE_TOKEN",
				"GOLOMT_SOCIALPAY_URL", "GOLOMT_SOCIALPAY_TERMINAL", "GOLOMT_SOCIALPAY_SECRET"{{end}}} {
				t.Setenv(k, "")
			}
			for k, v := range tt.env {
				t.Setenv(k, v)
			}
			c, err := Load()
			if tt.wantErr != "" {
				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
					t.Fatalf("err = %v, want it to mention %q", err, tt.wantErr)
				}
				return
			}
			if err != nil {
				t.Fatalf("unexpected error: %v", err)
			}
			tt.check(t, c)
		})
	}
}
