package telemetry

import (
	"context"
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"go.opentelemetry.io/otel/trace"
)

func TestSetupTracing_WithoutEndpoint(t *testing.T) {
	t.Setenv("OTEL_EXPORTER_OTLP_ENDPOINT", "")
	t.Setenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "")
	shutdown, err := SetupTracing(context.Background(), "test", "dev", slog.New(slog.NewJSONHandler(io.Discard, nil)))
	if err != nil {
		t.Fatal(err)
	}
	if err := shutdown(context.Background()); err != nil {
		t.Fatal(err)
	}
}

func TestRequestContinuesIncomingTrace(t *testing.T) {
	t.Setenv("OTEL_EXPORTER_OTLP_ENDPOINT", "")
	t.Setenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "")
	if _, err := SetupTracing(context.Background(), "test", "dev", slog.New(slog.NewJSONHandler(io.Discard, nil))); err != nil {
		t.Fatal(err)
	}
	tel := New("test")
	h := http.Header{}
	h.Set("traceparent", "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")
	ctx, end := tel.StartRequest(context.Background(), h, http.MethodGet)
	if got := trace.SpanContextFromContext(ctx).TraceID().String(); got != "4bf92f3577b34da6a3ce929d0e0e4736" {
		t.Errorf("trace id = %s, want the incoming one", got)
	}
	end("/api/v1/hello", http.StatusOK)
}

func TestNilTelemetryDoesNothing(t *testing.T) {
	var tel *Telemetry
	ctx, end := tel.StartRequest(context.Background(), http.Header{}, http.MethodGet)
	if ctx == nil {
		t.Fatal("nil context")
	}
	end("/x", http.StatusOK)
}

func TestMetrics(t *testing.T) {
	tel := New("test")
	_, end := tel.StartRequest(context.Background(), http.Header{}, http.MethodGet)
	end("/api/v1/hello", http.StatusOK)
	_, end = tel.StartRequest(context.Background(), http.Header{}, http.MethodGet)
	end("GET /api/v1/hello", http.StatusOK) // net/http pattern
	_, end = tel.StartRequest(context.Background(), http.Header{}, http.MethodGet)
	end("", http.StatusNotFound)

	rec := httptest.NewRecorder()
	tel.MetricsHandler().ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/metrics", nil))
	body, _ := io.ReadAll(rec.Body)
	for _, want := range []string{
		`http_request_duration_seconds_count{method="GET",route="/api/v1/hello",status="200"} 2`,
		`http_request_duration_seconds_count{method="GET",route="unmatched",status="404"} 1`,
		"go_goroutines",
	} {
		if !strings.Contains(string(body), want) {
			t.Errorf("metrics missing %q", want)
		}
	}
}
