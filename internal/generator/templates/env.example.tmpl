# Copy to .env for local development. Never commit .env.
SERVICE_NAME={{.Opt.Name}}
APP_ENV=dev
PORT=8080
# DEBUG is for development only; use INFO in production.
LOG_LEVEL=INFO
{{- if .HasDB}}
# Local development database (matches docker-compose defaults).
{{- if .Java}}
DATABASE_URL={{.DB.JavaLocalURL}}
DATABASE_USER=app
DATABASE_PASSWORD=app
{{- else}}
DATABASE_URL={{.DB.LocalURL}}
{{- end}}
{{- end}}
{{- if .Migrations}}
# Apply pending database migrations on start.
MIGRATE_ON_START=true
{{- end}}
{{- if .Auth}}
# Bearer token secret (HS256), at least 32 bytes. Generate one, e.g.
#   openssl rand -base64 48
# and keep it out of git. Issuer and audience are checked when set.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
{{- end}}
{{- if .Redis}}
# Redis for the cache (matches docker-compose defaults).
REDIS_URL=redis://localhost:6379/0
{{- end}}
{{- if .Observability}}
# Export traces with OTLP over HTTP; leave empty to export nothing.
{{- if .Java}}
TRACING_EXPORT_ENABLED=false
# Jaeger, Grafana Tempo or an OpenTelemetry Collector.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
{{- else}}
# Example (Jaeger, Grafana Tempo, an OpenTelemetry Collector): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
{{- end}}
{{- end}}
