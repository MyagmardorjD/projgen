# Copy to .env for local development. Never commit .env.
SERVICE_NAME={{.Opt.Name}}
APP_ENV=dev
PORT=8080
# DEBUG is for development only; use INFO in production.
LOG_LEVEL=INFO
{{- if .HasDB}}
# Local development database (matches docker-compose defaults).
{{- if .Java}}
DATABASE_URL={{.DB.JavaLocalURL}}
DATABASE_USER=app
DATABASE_PASSWORD=app
{{- else}}
DATABASE_URL={{.DB.LocalURL}}
{{- end}}
{{- end}}
{{- if .Migrations}}
# Apply pending database migrations on start.
MIGRATE_ON_START=true
{{- end}}
{{- if .Auth}}
# Bearer token secret (HS256), at least 32 bytes. Generate one, e.g.
#   openssl rand -base64 48
# and keep it out of git. Issuer and audience are checked when set.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
{{- end}}
{{- if .Redis}}
# Redis for the cache (matches docker-compose defaults).
REDIS_URL=redis://localhost:6379/0
{{- end}}
{{- if .QPay}}
# QPay V2 merchant (https://developer.qpay.mn). Sandbox endpoint by default;
# production is https://merchant.qpay.mn/v2. Keep the password out of git.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_ENDPOINT=https://merchant-sandbox.qpay.mn/v2
QPAY_CALLBACK_URL=http://localhost:8080/payments/qpay/callback
QPAY_INVOICE_CODE=
QPAY_MERCHANT_ID=
{{- end}}
{{- if .Bonum}}
# Bonum payment gateway: sandbox or production. The checksum key verifies webhooks.
BONUM_ENV=sandbox
BONUM_APP_SECRET=
BONUM_TERMINAL_ID=
BONUM_CHECKSUM_KEY=
{{- end}}
{{- if .Golomt}}
# Golomt Bank. Fill in eCommerce, SocialPay or both; a service is used when all of its values are set.
GOLOMT_ECOMMERCE_URL=https://ecommerce.golomtbank.com
GOLOMT_ECOMMERCE_SECRET=
GOLOMT_ECOMMERCE_TOKEN=
GOLOMT_SOCIALPAY_URL=
GOLOMT_SOCIALPAY_TERMINAL=
GOLOMT_SOCIALPAY_SECRET=
{{- end}}
{{- if .Observability}}
# Export traces with OTLP over HTTP; leave empty to export nothing.
{{- if .Java}}
TRACING_EXPORT_ENABLED=false
# Jaeger, Grafana Tempo or an OpenTelemetry Collector.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
{{- else}}
# Example (Jaeger, Grafana Tempo, an OpenTelemetry Collector): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
{{- end}}
{{- end}}
