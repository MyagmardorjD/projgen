package cache

import (
	"context"
	"os"
	"strconv"
	"testing"
	"time"
)

func TestOpen_BadURL(t *testing.T) {
	if _, err := Open("http://localhost", "test"); err == nil {
		t.Fatal("want an error for a non-redis URL")
	}
}

// TestCache runs against TEST_REDIS_URL. Without the variable it is skipped,
// so go test ./... needs no Redis. Keys are prefixed, so a shared server is fine.
func TestCache(t *testing.T) {
	url := os.Getenv("TEST_REDIS_URL")
	if url == "" {
		t.Skip("set TEST_REDIS_URL to run cache tests against a real Redis")
	}
	c, err := Open(url, "{{.Opt.Name}}-test-"+strconv.FormatInt(time.Now().UnixNano(), 36))
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { c.Close() })
	ctx := context.Background()
	if err := c.PingContext(ctx); err != nil {
		t.Fatalf("ping: %v", err)
	}

	type item struct {
		Name  string  `json:"name"`
		Price float64 `json:"price"`
	}
	var got item
	if ok, err := c.Get(ctx, "missing", &got); ok || err != nil {
		t.Fatalf("missing key: ok = %v, err = %v", ok, err)
	}
	if err := c.Set(ctx, "a", item{"pen", 9.5}, time.Minute); err != nil {
		t.Fatal(err)
	}
	if ok, err := c.Get(ctx, "a", &got); !ok || err != nil || got != (item{"pen", 9.5}) {
		t.Fatalf("get: %+v, ok = %v, err = %v", got, ok, err)
	}
	if err := c.Delete(ctx, "a"); err != nil {
		t.Fatal(err)
	}
	if ok, _ := c.Get(ctx, "a", &got); ok {
		t.Error("key still present after Delete")
	}
}
