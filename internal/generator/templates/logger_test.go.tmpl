package logger

import (
	"bytes"
	"context"
	"encoding/json"
	"testing"
)

func TestLogFormat(t *testing.T) {
	var buf bytes.Buffer
	log := NewWithWriter(&buf, "svc", "test", "INFO")
	ctx := WithRequestID(context.Background(), "req-1")

	FromContext(ctx, log).Info("order created", "order_id", 42)

	var got map[string]any
	if err := json.Unmarshal(buf.Bytes(), &got); err != nil {
		t.Fatalf("log line is not JSON: %v: %s", err, buf.String())
	}
	want := map[string]any{
		"level": "INFO", "message": "order created", "service": "svc",
		"env": "test", "logger": "app", "request_id": "req-1", "order_id": float64(42),
	}
	for k, v := range want {
		if got[k] != v {
			t.Errorf("%s = %v, want %v", k, got[k], v)
		}
	}
	if _, ok := got["@timestamp"]; !ok {
		t.Error("missing @timestamp")
	}
}

func TestDebugHiddenAtInfo(t *testing.T) {
	var buf bytes.Buffer
	NewWithWriter(&buf, "svc", "test", "INFO").Debug("hidden")
	if buf.Len() != 0 {
		t.Errorf("debug log written at INFO level: %s", buf.String())
	}
}

func TestRequestIDFrom(t *testing.T) {
	if got := RequestIDFrom("abc-123"); got != "abc-123" {
		t.Errorf("safe header replaced: %q", got)
	}
	for _, bad := range []string{"", "has space", "<script>", string(make([]byte, 65))} {
		if got := RequestIDFrom(bad); got == bad || len(got) != 32 {
			t.Errorf("RequestIDFrom(%q) = %q, want a new 32-char id", bad, got)
		}
	}
}
