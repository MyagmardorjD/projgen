stages:
  - test
{{- if .Sonar}}
  - analyze
{{- end}}
  - build

test:
  stage: test
  image: golang:{{.V.Go}}
  script:
    - test -z "$(gofmt -l .)"
    - go vet ./...
    - go test -race -coverprofile=coverage.out ./...
    - go tool cover -func=coverage.out
{{- if .Sonar}}
  artifacts:
    paths:
      - coverage.out
{{- end}}
{{- if .Sonar}}

# Needs the CI/CD variables SONAR_HOST_URL and SONAR_TOKEN (masked); skipped until SONAR_TOKEN is set.
sonarqube:
  stage: analyze
  image:
    name: {{.SonarImage}}
    entrypoint: [""]
  needs: [test]
  variables:
    GIT_DEPTH: "0" # full history for SonarQube blame and new-code detection
    SONAR_USER_HOME: "$CI_PROJECT_DIR/.sonar"
  cache:
    key: sonar
    paths:
      - .sonar/cache
  script:
    - sonar-scanner
  rules:
    - if: $SONAR_TOKEN
{{- end}}

build:
  stage: build
  image: golang:{{.V.Go}}
  script:
    - CGO_ENABLED=0 go build -o bin/{{.Opt.Name}} ./cmd/server
  artifacts:
    paths:
      - bin/
