{{- if .Observability}}

func TestMetrics(t *testing.T) {
	d := testDeps(nil)
	d.Telemetry = telemetry.New("test")
	do(t, d, httptest.NewRequest(http.MethodGet, "/api/v1/hello", nil))
	status, body, _ := do(t, d, httptest.NewRequest(http.MethodGet, "/metrics", nil))
	if status != http.StatusOK {
		t.Fatalf("GET /metrics = %d", status)
	}
	want := `http_request_duration_seconds_count{method="GET",route="/api/v1/hello",status="200"} 1`
	if !strings.Contains(body, want) {
		t.Errorf("metrics missing %s:\n%s", want, body)
	}
}
