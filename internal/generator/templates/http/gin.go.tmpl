// Package {{.P.http.Name}} exposes the service over HTTP using Gin.
package {{.P.http.Name}}

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"time"

	"github.com/gin-gonic/gin"

	"{{.P.domain.Import}}"
{{- if .Auth}}
	"{{.P.auth.Import}}"
{{- end}}
	"{{.P.logger.Import}}"
	{{.P.service.Name}} "{{.P.service.Import}}"
{{- if .Observability}}
	"{{.P.telemetry.Import}}"
{{- end}}
)

// HealthChecker is implemented by *sql.DB and anything else /health should ping.
type HealthChecker interface {
	PingContext(ctx context.Context) error
}
{{- if .Redis}}

// HealthChecks pings every checker in order and returns the first error.
type HealthChecks []HealthChecker

func (hs HealthChecks) PingContext(ctx context.Context) error {
	for _, h := range hs {
		if err := h.PingContext(ctx); err != nil {
			return err
		}
	}
	return nil
}
{{- end}}

// Deps are the dependencies of the HTTP layer. Health may be nil.
type Deps struct {
	Greeter *{{.P.service.Name}}.Greeter
	Health  HealthChecker
	Logger  *slog.Logger
{{- if .Auth}}
	// Auth checks bearer tokens on /api/v1; nil turns authentication off (tests).
	Auth *auth.Verifier
{{- end}}
{{- if .Observability}}
	// Telemetry serves /metrics and traces requests; nil turns both off (tests).
	Telemetry *telemetry.Telemetry
{{- end}}
	// projgen:deps (projgen add entity inserts fields here)
}

// NewRouter builds the HTTP handler with all routes and middleware.
func NewRouter(d Deps) http.Handler {
	gin.SetMode(gin.ReleaseMode)
	r := gin.New()
	r.Use(gin.Recovery(), requestLogger(d.Logger{{if .Observability}}, d.Telemetry{{end}}))
	r.GET("/health", health(d))
{{- if .Observability}}
	if d.Telemetry != nil {
		r.GET("/metrics", gin.WrapH(d.Telemetry.MetricsHandler()))
	}
{{- end}}
	v1 := r.Group("/api/v1")
{{- if .Auth}}
	if d.Auth != nil {
		v1.Use(requireAuth(d.Auth))
	}
{{- end}}
	v1.GET("/hello", hello(d))
{{- if .Auth}}
	v1.GET("/me", me)
{{- end}}
	// projgen:routes (projgen add entity inserts routes here)
	return r
}

// Serve runs the server until ctx is cancelled, then shuts down gracefully.
func Serve(ctx context.Context, addr string, d Deps) error {
	srv := &http.Server{Addr: addr, Handler: NewRouter(d), ReadHeaderTimeout: 5 * time.Second}
	errCh := make(chan error, 1)
	go func() { errCh <- srv.ListenAndServe() }()
	select {
	case err := <-errCh:
		return err
	case <-ctx.Done():
	}
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	return srv.Shutdown(shutdownCtx)
}

func requestLogger(base *slog.Logger{{if .Observability}}, tel *telemetry.Telemetry{{end}}) gin.HandlerFunc {
	return func(c *gin.Context) {
		start := time.Now()
		id := logger.RequestIDFrom(c.GetHeader("X-Request-ID"))
		c.Header("X-Request-ID", id)
{{- if .Observability}}
		ctx, end := tel.StartRequest(logger.WithRequestID(c.Request.Context(), id), c.Request.Header, c.Request.Method)
		c.Request = c.Request.WithContext(ctx)
		c.Next()
		end(c.FullPath(), c.Writer.Status())
{{- else}}
		c.Request = c.Request.WithContext(logger.WithRequestID(c.Request.Context(), id))
		c.Next()
{{- end}}
		logger.FromContext(c.Request.Context(), base).Info("request completed",
			"method", c.Request.Method,
			"path", c.FullPath(),
			"status", c.Writer.Status(),
			"duration_ms", time.Since(start).Milliseconds())
	}
}

{{if .Auth -}}
// requireAuth rejects requests without a valid bearer token with 401.
func requireAuth(v *auth.Verifier) gin.HandlerFunc {
	return func(c *gin.Context) {
		claims, err := v.Verify(c.GetHeader("Authorization"))
		if err != nil {
			c.Header("WWW-Authenticate", "Bearer")
			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
			return
		}
		c.Request = c.Request.WithContext(auth.WithClaims(c.Request.Context(), claims))
		c.Next()
	}
}

// me returns who the bearer token belongs to.
func me(c *gin.Context) {
	claims, _ := auth.FromContext(c.Request.Context())
	c.JSON(http.StatusOK, gin.H{"subject": claims.Subject})
}

{{end -}}
func health(d Deps) gin.HandlerFunc {
	return func(c *gin.Context) {
		if d.Health != nil {
			ctx, cancel := context.WithTimeout(c.Request.Context(), 2*time.Second)
			defer cancel()
			if err := d.Health.PingContext(ctx); err != nil {
				logger.FromContext(ctx, d.Logger).Error("health check failed", "error", err)
				c.JSON(http.StatusServiceUnavailable, gin.H{"status": "unavailable"})
				return
			}
		}
		c.JSON(http.StatusOK, gin.H{"status": "ok"})
	}
}

func hello(d Deps) gin.HandlerFunc {
	return func(c *gin.Context) {
		g, err := d.Greeter.Greet(c.Request.Context(), c.Query("name"))
		switch {
		case errors.Is(err, {{.P.domain.Name}}.ErrNameTooLong):
			c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		case err != nil:
			logger.FromContext(c.Request.Context(), d.Logger).Error("greet failed", "error", err)
			c.JSON(http.StatusInternalServerError, gin.H{"error": "internal error"})
		default:
			c.JSON(http.StatusOK, g)
		}
	}
}
