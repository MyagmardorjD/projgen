// Package {{.P.http.Name}} exposes the service over HTTP using Echo.
package {{.P.http.Name}}

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"time"

	"github.com/labstack/echo/v4"
	"github.com/labstack/echo/v4/middleware"

	"{{.P.domain.Import}}"
{{- if .Auth}}
	"{{.P.auth.Import}}"
{{- end}}
	"{{.P.logger.Import}}"
	{{.P.service.Name}} "{{.P.service.Import}}"
{{- if .Observability}}
	"{{.P.telemetry.Import}}"
{{- end}}
)

// HealthChecker is implemented by *sql.DB and anything else /health should ping.
type HealthChecker interface {
	PingContext(ctx context.Context) error
}
{{- if .Redis}}

// HealthChecks pings every checker in order and returns the first error.
type HealthChecks []HealthChecker

func (hs HealthChecks) PingContext(ctx context.Context) error {
	for _, h := range hs {
		if err := h.PingContext(ctx); err != nil {
			return err
		}
	}
	return nil
}
{{- end}}

// Deps are the dependencies of the HTTP layer. Health may be nil.
type Deps struct {
	Greeter *{{.P.service.Name}}.Greeter
	Health  HealthChecker
	Logger  *slog.Logger
{{- if .Auth}}
	// Auth checks bearer tokens on /api/v1; nil turns authentication off (tests).
	Auth *auth.Verifier
{{- end}}
{{- if .Observability}}
	// Telemetry serves /metrics and traces requests; nil turns both off (tests).
	Telemetry *telemetry.Telemetry
{{- end}}
	// projgen:deps (projgen add entity inserts fields here)
}

// NewRouter builds the HTTP handler with all routes and middleware.
func NewRouter(d Deps) http.Handler {
	e := echo.New()
	e.HideBanner = true
	e.HidePort = true
	e.Use(middleware.Recover(), requestLogger(d.Logger{{if .Observability}}, d.Telemetry{{end}}))
	e.GET("/health", health(d))
{{- if .Observability}}
	if d.Telemetry != nil {
		e.GET("/metrics", echo.WrapHandler(d.Telemetry.MetricsHandler()))
	}
{{- end}}
	v1 := e.Group("/api/v1")
{{- if .Auth}}
	if d.Auth != nil {
		v1.Use(requireAuth(d.Auth))
	}
{{- end}}
	v1.GET("/hello", hello(d))
{{- if .Auth}}
	v1.GET("/me", me)
{{- end}}
	// projgen:routes (projgen add entity inserts routes here)
	return e
}

// Serve runs the server until ctx is cancelled, then shuts down gracefully.
func Serve(ctx context.Context, addr string, d Deps) error {
	srv := &http.Server{Addr: addr, Handler: NewRouter(d), ReadHeaderTimeout: 5 * time.Second}
	errCh := make(chan error, 1)
	go func() { errCh <- srv.ListenAndServe() }()
	select {
	case err := <-errCh:
		return err
	case <-ctx.Done():
	}
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	return srv.Shutdown(shutdownCtx)
}

func requestLogger(base *slog.Logger{{if .Observability}}, tel *telemetry.Telemetry{{end}}) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			start := time.Now()
			req := c.Request()
			id := logger.RequestIDFrom(req.Header.Get("X-Request-ID"))
			c.Response().Header().Set("X-Request-ID", id)
{{- if .Observability}}
			ctx, end := tel.StartRequest(logger.WithRequestID(req.Context(), id), req.Header, req.Method)
			c.SetRequest(req.WithContext(ctx))
			if err := next(c); err != nil {
				c.Error(err)
			}
			end(c.Path(), c.Response().Status)
{{- else}}
			c.SetRequest(req.WithContext(logger.WithRequestID(req.Context(), id)))
			if err := next(c); err != nil {
				c.Error(err)
			}
{{- end}}
			logger.FromContext(c.Request().Context(), base).Info("request completed",
				"method", req.Method,
				"path", c.Path(),
				"status", c.Response().Status,
				"duration_ms", time.Since(start).Milliseconds())
			return nil
		}
	}
}

{{if .Auth -}}
// requireAuth rejects requests without a valid bearer token with 401.
func requireAuth(v *auth.Verifier) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			claims, err := v.Verify(c.Request().Header.Get("Authorization"))
			if err != nil {
				c.Response().Header().Set("WWW-Authenticate", "Bearer")
				return c.JSON(http.StatusUnauthorized, map[string]string{"error": "unauthorized"})
			}
			c.SetRequest(c.Request().WithContext(auth.WithClaims(c.Request().Context(), claims)))
			return next(c)
		}
	}
}

// me returns who the bearer token belongs to.
func me(c echo.Context) error {
	claims, _ := auth.FromContext(c.Request().Context())
	return c.JSON(http.StatusOK, map[string]string{"subject": claims.Subject})
}

{{end -}}
func health(d Deps) echo.HandlerFunc {
	return func(c echo.Context) error {
		if d.Health != nil {
			ctx, cancel := context.WithTimeout(c.Request().Context(), 2*time.Second)
			defer cancel()
			if err := d.Health.PingContext(ctx); err != nil {
				logger.FromContext(ctx, d.Logger).Error("health check failed", "error", err)
				return c.JSON(http.StatusServiceUnavailable, map[string]string{"status": "unavailable"})
			}
		}
		return c.JSON(http.StatusOK, map[string]string{"status": "ok"})
	}
}

func hello(d Deps) echo.HandlerFunc {
	return func(c echo.Context) error {
		g, err := d.Greeter.Greet(c.Request().Context(), c.QueryParam("name"))
		switch {
		case errors.Is(err, {{.P.domain.Name}}.ErrNameTooLong):
			return c.JSON(http.StatusBadRequest, map[string]string{"error": err.Error()})
		case err != nil:
			logger.FromContext(c.Request().Context(), d.Logger).Error("greet failed", "error", err)
			return c.JSON(http.StatusInternalServerError, map[string]string{"error": "internal error"})
		}
		return c.JSON(http.StatusOK, g)
	}
}
