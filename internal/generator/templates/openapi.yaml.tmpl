openapi: 3.0.3
info:
  title: {{.Opt.Name}}
  version: 0.1.0
paths:
  /health:
    get:
      summary: Liveness and dependency check
      responses:
        "200":
          description: Service is healthy
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Status"
        "503":
          description: A dependency is unavailable
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Status"
{{- if .Observability}}
  /metrics:
    get:
      summary: Prometheus metrics
      responses:
        "200":
          description: Metrics in the Prometheus text format
          content:
            text/plain:
              schema:
                type: string
{{- end}}
  /api/v1/hello:
    get:
      summary: Example endpoint returning a greeting
{{- if .Auth}}
      security:
        - bearerAuth: []
{{- end}}
      parameters:
        - name: name
          in: query
          required: false
          schema:
            type: string
            maxLength: 100
      responses:
        "200":
          description: Greeting
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Greeting"
        "400":
          description: Name too long
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
{{- if .Auth}}
        "401":
          $ref: "#/components/responses/Unauthorized"
  /api/v1/me:
    get:
      summary: Who the bearer token belongs to
      security:
        - bearerAuth: []
      responses:
        "200":
          description: Token subject
          content:
            application/json:
              schema:
                type: object
                properties:
                  subject:
                    type: string
                    example: alice
        "401":
          $ref: "#/components/responses/Unauthorized"
{{- end}}
components:
{{- if .Auth}}
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
  responses:
    Unauthorized:
      description: Missing, invalid or expired bearer token
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
{{- end}}
  schemas:
    Status:
      type: object
      properties:
        status:
          type: string
          example: ok
    Greeting:
      type: object
      properties:
        message:
          type: string
          example: Hello, World!
    Error:
      type: object
      properties:
        error:
          type: string
