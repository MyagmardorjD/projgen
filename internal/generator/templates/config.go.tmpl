// Package config reads service settings from environment variables.
package config

import (
	"fmt"
	"os"
	"strconv"
)

// Config holds every setting the service needs.
type Config struct {
	ServiceName string
	Env         string
	Port        string
	LogLevel    string
{{- if .HasDB}}
	DatabaseURL string
{{- end}}
{{- if .Migrations}}
	// MigrateOnStart applies pending migrations before serving (MIGRATE_ON_START, default true).
	MigrateOnStart bool
{{- end}}
{{- if .Auth}}
	// JWTSecret signs and verifies bearer tokens (HS256, at least 32 bytes). Never log it.
	JWTSecret   string
	JWTIssuer   string // checked when set
	JWTAudience string // checked when set
{{- end}}
{{- if .Redis}}
	RedisURL string // redis://user:password@host:6379/0
{{- end}}
}

// Load reads the configuration. Secrets come only from the environment.
func Load() (Config, error) {
	c := Config{
		ServiceName: getenv("SERVICE_NAME", "{{.Opt.Name}}"),
		Env:         getenv("APP_ENV", "dev"),
		Port:        getenv("PORT", "8080"),
		LogLevel:    getenv("LOG_LEVEL", "INFO"),
{{- if .HasDB}}
		DatabaseURL: os.Getenv("DATABASE_URL"),
{{- end}}
{{- if .Auth}}
		JWTSecret:   os.Getenv("JWT_SECRET"),
		JWTIssuer:   os.Getenv("JWT_ISSUER"),
		JWTAudience: os.Getenv("JWT_AUDIENCE"),
{{- end}}
{{- if .Redis}}
		RedisURL: os.Getenv("REDIS_URL"),
{{- end}}
	}
	if _, err := strconv.Atoi(c.Port); err != nil {
		return Config{}, fmt.Errorf("config: PORT %q is not a number", c.Port)
	}
{{- if .Migrations}}
	migrate, err := strconv.ParseBool(getenv("MIGRATE_ON_START", "true"))
	if err != nil {
		return Config{}, fmt.Errorf("config: MIGRATE_ON_START %q is not true or false", os.Getenv("MIGRATE_ON_START"))
	}
	c.MigrateOnStart = migrate
{{- end}}
{{- if .HasDB}}
	if c.DatabaseURL == "" {
		return Config{}, fmt.Errorf("config: DATABASE_URL is required")
	}
{{- end}}
{{- if .Auth}}
	if len(c.JWTSecret) < 32 {
		return Config{}, fmt.Errorf("config: JWT_SECRET is required and must be at least 32 bytes")
	}
{{- end}}
{{- if .Redis}}
	if c.RedisURL == "" {
		return Config{}, fmt.Errorf("config: REDIS_URL is required")
	}
{{- end}}
	return c, nil
}

func getenv(key, def string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return def
}
