{
  "@timestamp": {
    "$resolver": "timestamp",
    "pattern": { "format": "yyyy-MM-dd'T'HH:mm:ss.SSSXXX", "timeZone": "UTC" }
  },
  "level": { "$resolver": "level", "field": "name" },
  "message": { "$resolver": "message", "stringified": true },
  "logger": { "$resolver": "logger", "field": "name" },
{{- if .Observability}}
  "trace_id": { "$resolver": "mdc", "key": "traceId" },
  "span_id": { "$resolver": "mdc", "key": "spanId" },
  "context": { "$resolver": "mdc", "flatten": true, "stringified": true, "pattern": "^(?!traceId$|spanId$).*" },
{{- else}}
  "context": { "$resolver": "mdc", "flatten": true, "stringified": true },
{{- end}}
  "error_type": { "$resolver": "exception", "field": "className" },
  "error": { "$resolver": "exception", "field": "stackTrace", "stackTrace": { "stringified": true } }
}
