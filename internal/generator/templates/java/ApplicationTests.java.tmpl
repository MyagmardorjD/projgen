package {{.BasePkg}};

import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;

/** Starts the whole application context to check the wiring. */
{{- if .HasDB}}
// The pool connects lazily, so an unreachable database URL is enough here.
{{- if .Migrations}}
// Flyway would connect on start, so it is off; MigrationTests covers it.
{{- end}}
@SpringBootTest(properties = {
        "spring.datasource.url=jdbc:{{if eq .Opt.Database "postgresql"}}postgresql{{else}}mysql{{end}}://127.0.0.1:1/none",
{{- if .Migrations}}
        "spring.flyway.enabled=false",
{{- end}}
})
{{- else}}
@SpringBootTest
{{- end}}
class {{.App}}Tests {

    @Test
    void contextLoads() {
    }
}
