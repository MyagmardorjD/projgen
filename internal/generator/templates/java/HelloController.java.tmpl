package {{.P.http.Name}};

import {{.P.domain.Name}}.Greeting;
import {{.P.service.Name}}.GreeterService;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

/** Example endpoint: GET /api/v1/hello?name=Bat */
@RestController
@RequestMapping("/api/v1")
public class HelloController {

    private final GreeterService greeter;

    public HelloController(GreeterService greeter) {
        this.greeter = greeter;
    }

    @GetMapping("/hello")
    public Greeting hello(@RequestParam(name = "name", required = false) String name) {
        return greeter.greet(name);
    }
}
