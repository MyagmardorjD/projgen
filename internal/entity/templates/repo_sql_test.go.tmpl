// open{{.E.Name}}TestDB connects to TEST_DATABASE_URL and recreates every
// table from the migrations, so tables that refer to each other are dropped
// and created in order. Use a throwaway database. Without the variable the
// test is skipped, so go test ./... stays fast and needs no database.
func open{{.E.Name}}TestDB(t *testing.T) *sql.DB {
	t.Helper()
	url := os.Getenv("TEST_DATABASE_URL")
	if url == "" {
		t.Skip("set TEST_DATABASE_URL to run repository tests against a real database")
	}
	db, err := Open(url)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { db.Close() })

	run := func(files []string) {
		for _, f := range files {
			b, err := os.ReadFile(f)
			if err != nil {
				t.Fatal(err)
			}
			if _, err := db.Exec(string(b)); err != nil {
				t.Fatalf("%s: %v", filepath.Base(f), err)
			}
		}
	}
	ups, _ := filepath.Glob(filepath.Join("{{.MigrationsRel}}", "*.up.sql"))
	downs, _ := filepath.Glob(filepath.Join("{{.MigrationsRel}}", "*.down.sql"))
	slices.Sort(ups)
	slices.Sort(downs)
	slices.Reverse(downs)
	run(downs)
	run(ups)
	t.Cleanup(func() { run(downs) })
	return db
}
{{- if .Seeds}}

// insert{{.E.Name}}Parent stores a row a ref field can point at and returns its id.
func insert{{.E.Name}}Parent(t *testing.T, db *sql.DB, query string, args ...any) int64 {
	t.Helper()
{{- if eq .Opt.Database "postgresql"}}
	var id int64
	if err := db.QueryRow(query+" RETURNING id", args...).Scan(&id); err != nil {
		t.Fatalf("%s: %v", query, err)
	}
	return id
{{- else}}
	res, err := db.Exec(query, args...)
	if err != nil {
		t.Fatalf("%s: %v", query, err)
	}
	id, err := res.LastInsertId()
	if err != nil {
		t.Fatal(err)
	}
	return id
{{- end}}
}
{{- end}}

func Test{{.E.Name}}Repository_CRUD(t *testing.T) {
	ctx := context.Background()
	db := open{{.E.Name}}TestDB(t)
	r := New{{.E.Name}}Repository(db)
{{- range .Seeds}}
	{{.Var}} := insert{{$.E.Name}}Parent(t, db, "{{.GoSQL}}"{{range .Args}}, {{.}}{{end}})
{{- end}}
	in := {{$d}}.{{.E.Name}}Input{
{{- range .Fields}}
		{{.Go}}: {{if .Ref}}{{.SeedVar}}{{else}}{{.Sample}}{{end}},
{{- end}}
	}
	same := func(t *testing.T, got {{$d}}.{{.E.Name}}) {
		t.Helper()
{{- range .Fields}}
{{- if eq .GoType "time.Time"}}
		if !got.{{.Go}}.Equal(in.{{.Go}}) {
{{- else}}
		if got.{{.Go}} != in.{{.Go}} {
{{- end}}
			t.Errorf("{{.JSON}} = %v, want %v", got.{{.Go}}, in.{{.Go}})
		}
{{- end}}
		if got.CreatedAt.IsZero() || got.UpdatedAt.IsZero() {
			t.Error("timestamps not set")
		}
	}

	created, err := r.Create(ctx, in)
	if err != nil {
		t.Fatalf("create: %v", err)
	}
	if created.ID == 0 {
		t.Fatal("create: no id")
	}
	same(t, created)

	got, err := r.Get(ctx, created.ID)
	if err != nil {
		t.Fatalf("get: %v", err)
	}
	same(t, got)

	list, err := r.List(ctx, {{if .Refs}}{{$d}}.{{.E.Name}}Filter{}, {{end}}10, 0)
	if err != nil || len(list) != 1 || list[0].ID != created.ID {
		t.Fatalf("list = %v, %v; want the created record", list, err)
	}
	if list, err := r.List(ctx, {{if .Refs}}{{$d}}.{{.E.Name}}Filter{}, {{end}}10, 1); err != nil || len(list) != 0 {
		t.Errorf("list offset 1 = %v, %v; want empty", list, err)
	}
{{- range .Refs}}
	if list, err := r.List(ctx, {{$d}}.{{$.E.Name}}Filter{ {{- .Go}}: {{.SeedVar}}}, 10, 0); err != nil || len(list) != 1 {
		t.Errorf("list by {{.JSON}} = %v, %v; want the created record", list, err)
	}
	if list, err := r.List(ctx, {{$d}}.{{$.E.Name}}Filter{ {{- .Go}}: {{.SeedVar}} + 1000}, 10, 0); err != nil || len(list) != 0 {
		t.Errorf("list by another {{.JSON}} = %v, %v; want empty", list, err)
	}
	{
		missing := in
		missing.{{.Go}} = {{.SeedVar}} + 1000
		if _, err := r.Create(ctx, missing); !errors.Is(err, {{$d}}.ErrValidation) {
			t.Errorf("create with unknown {{.JSON}}: err = %v, want ErrValidation", err)
		}
	}
{{- if .MapsConflict}}
	if err := New{{.Target.Name}}Repository(db).Delete(ctx, {{.SeedVar}}); !errors.Is(err, {{$d}}.ErrConflict) {
		t.Errorf("delete a {{.Target.Snake}} still referred to: err = %v, want ErrConflict", err)
	}
{{- end}}
{{- end}}

	time.Sleep(10 * time.Millisecond)
	updated, err := r.Update(ctx, created.ID, in)
	if err != nil {
		t.Fatalf("update: %v", err)
	}
	same(t, updated)
	if _, err := r.Update(ctx, created.ID+1000, in); !errors.Is(err, {{$d}}.ErrNotFound) {
		t.Errorf("update missing: err = %v, want ErrNotFound", err)
	}

	if err := r.Delete(ctx, created.ID); err != nil {
		t.Fatalf("delete: %v", err)
	}
	if _, err := r.Get(ctx, created.ID); !errors.Is(err, {{$d}}.ErrNotFound) {
		t.Errorf("get deleted: err = %v, want ErrNotFound", err)
	}
	if err := r.Delete(ctx, created.ID); !errors.Is(err, {{$d}}.ErrNotFound) {
		t.Errorf("delete twice: err = %v, want ErrNotFound", err)
	}
}
