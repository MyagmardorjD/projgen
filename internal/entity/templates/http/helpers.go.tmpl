{{- $d := .P.domain.Name -}}
{{- $fw := .Opt.Framework -}}
package {{.P.http.Name}}

import (
	"encoding/json"
	"errors"
	"log/slog"
	"net/http"
	"strconv"
{{- if eq $fw "gin"}}

	"github.com/gin-gonic/gin"
{{- else if eq $fw "echo"}}

	"github.com/labstack/echo/v4"
{{- else if eq $fw "fiber"}}

	"github.com/gofiber/fiber/v2"
{{- end}}

	"{{.P.domain.Import}}"
	"{{.P.logger.Import}}"
)

// Shared by every entity handler. Generated once by projgen add entity.

const maxBodyBytes = 1 << 20

{{if eq $fw "gin" -}}
// entityError writes the response for a service error. Unexpected errors are
// logged once, here at the boundary, and hidden from the client.
func entityError(c *gin.Context, log *slog.Logger, err error) {
	switch {
	case errors.Is(err, {{$d}}.ErrNotFound):
		c.JSON(http.StatusNotFound, gin.H{"error": "not found"})
	case errors.Is(err, {{$d}}.ErrValidation):
		c.JSON(http.StatusUnprocessableEntity, gin.H{"error": err.Error()})
	default:
		logger.FromContext(c.Request.Context(), log).Error("request failed", "error", err)
		c.JSON(http.StatusInternalServerError, gin.H{"error": "internal error"})
	}
}
{{- else if eq $fw "echo" -}}
// entityError writes the response for a service error. Unexpected errors are
// logged once, here at the boundary, and hidden from the client.
func entityError(c echo.Context, log *slog.Logger, err error) error {
	switch {
	case errors.Is(err, {{$d}}.ErrNotFound):
		return c.JSON(http.StatusNotFound, map[string]string{"error": "not found"})
	case errors.Is(err, {{$d}}.ErrValidation):
		return c.JSON(http.StatusUnprocessableEntity, map[string]string{"error": err.Error()})
	}
	logger.FromContext(c.Request().Context(), log).Error("request failed", "error", err)
	return c.JSON(http.StatusInternalServerError, map[string]string{"error": "internal error"})
}
{{- else if eq $fw "fiber" -}}
// entityError writes the response for a service error. Unexpected errors are
// logged once, here at the boundary, and hidden from the client.
func entityError(c *fiber.Ctx, log *slog.Logger, err error) error {
	switch {
	case errors.Is(err, {{$d}}.ErrNotFound):
		return c.Status(http.StatusNotFound).JSON(fiber.Map{"error": "not found"})
	case errors.Is(err, {{$d}}.ErrValidation):
		return c.Status(http.StatusUnprocessableEntity).JSON(fiber.Map{"error": err.Error()})
	}
	logger.FromContext(c.UserContext(), log).Error("request failed", "error", err)
	return c.Status(http.StatusInternalServerError).JSON(fiber.Map{"error": "internal error"})
}
{{- else -}}
// entityError writes the response for a service error. Unexpected errors are
// logged once, here at the boundary, and hidden from the client.
func entityError(w http.ResponseWriter, r *http.Request, log *slog.Logger, err error) {
	switch {
	case errors.Is(err, {{$d}}.ErrNotFound):
		writeJSON(w, http.StatusNotFound, map[string]string{"error": "not found"})
	case errors.Is(err, {{$d}}.ErrValidation):
		writeJSON(w, http.StatusUnprocessableEntity, map[string]string{"error": err.Error()})
	default:
		logger.FromContext(r.Context(), log).Error("request failed", "error", err)
		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": "internal error"})
	}
}
{{- end}}

// decodeBody reads a JSON request body of at most maxBodyBytes.
func decodeBody(w http.ResponseWriter, r *http.Request, v any) error {
	return json.NewDecoder(http.MaxBytesReader(w, r.Body, maxBodyBytes)).Decode(v)
}

// pathID parses a positive record id from the URL.
func pathID(s string) (int64, bool) {
	id, err := strconv.ParseInt(s, 10, 64)
	return id, err == nil && id > 0
}

// pageParams reads ?limit= and ?offset=; bad values become 0 and the
// service applies its defaults.
func pageParams(limit, offset string) (int, int) {
	l, _ := strconv.Atoi(limit)
	o, _ := strconv.Atoi(offset)
	return l, o
}
