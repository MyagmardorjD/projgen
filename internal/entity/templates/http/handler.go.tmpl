// register{{.E.Name}}Routes adds the {{.E.Table}} CRUD routes under r.
func register{{.E.Name}}Routes(r *gin.RouterGroup, s *{{$s}}.{{.E.Name}}Service, log *slog.Logger) {
	if s == nil {
		return
	}
	h := {{$h}}{s: s, log: log}
	r.POST("/{{.E.Route}}", h.create)
	r.GET("/{{.E.Route}}", h.list)
	r.GET("/{{.E.Route}}/:id", h.get)
	r.PUT("/{{.E.Route}}/:id", h.update)
	r.DELETE("/{{.E.Route}}/:id", h.delete)
}

type {{$h}} struct {
	s   *{{$s}}.{{.E.Name}}Service
	log *slog.Logger
}

func (h {{$h}}) create(c *gin.Context) {
	var in {{$d}}.{{.E.Name}}Input
	if err := decodeBody(c.Writer, c.Request, &in); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid JSON body"})
		return
	}
	x, err := h.s.Create(c.Request.Context(), in)
	if err != nil {
		entityError(c, h.log, err)
		return
	}
	c.JSON(http.StatusCreated, x)
}

func (h {{$h}}) list(c *gin.Context) {
	limit, offset := pageParams(c.Query("limit"), c.Query("offset"))
	items, err := h.s.List(c.Request.Context(), limit, offset)
	if err != nil {
		entityError(c, h.log, err)
		return
	}
	c.JSON(http.StatusOK, items)
}

func (h {{$h}}) get(c *gin.Context) {
	id, ok := pathID(c.Param("id"))
	if !ok {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid id"})
		return
	}
	x, err := h.s.Get(c.Request.Context(), id)
	if err != nil {
		entityError(c, h.log, err)
		return
	}
	c.JSON(http.StatusOK, x)
}

func (h {{$h}}) update(c *gin.Context) {
	id, ok := pathID(c.Param("id"))
	if !ok {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid id"})
		return
	}
	var in {{$d}}.{{.E.Name}}Input
	if err := decodeBody(c.Writer, c.Request, &in); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid JSON body"})
		return
	}
	x, err := h.s.Update(c.Request.Context(), id, in)
	if err != nil {
		entityError(c, h.log, err)
		return
	}
	c.JSON(http.StatusOK, x)
}

func (h {{$h}}) delete(c *gin.Context) {
	id, ok := pathID(c.Param("id"))
	if !ok {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid id"})
		return
