class {{.E.Name}}ControllerTest {

    private static final String PATH = "/api/v1/{{.E.Route}}";
    private static final String BODY = """
            { {{- .SampleJSON -}} }""";

    private final MockMvc mvc = MockMvcBuilders
            .standaloneSetup(new {{.E.Name}}Controller(new {{.E.Name}}Service(new InMemory{{.E.Name}}Repository())))
            .setControllerAdvice(new EntityExceptionHandler(), new ApiExceptionHandler())
            .build();

    @Test
    void crud() throws Exception {
        mvc.perform(post(PATH).contentType(MediaType.APPLICATION_JSON).content(BODY))
                .andExpect(status().isCreated())
                .andExpect(jsonPath("$.id").value(1))
{{- range .Fields}}
                .andExpect(jsonPath("$.{{.JSON}}").exists())
{{- end}}
                .andExpect(jsonPath("$.created_at").exists());
        mvc.perform(get(PATH + "/1"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id").value(1));
        mvc.perform(get(PATH).param("limit", "abc"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(1));
        mvc.perform(put(PATH + "/1").contentType(MediaType.APPLICATION_JSON).content(BODY))
                .andExpect(status().isOk());
        mvc.perform(delete(PATH + "/1"))
                .andExpect(status().isNoContent());
        mvc.perform(get(PATH + "/1"))
                .andExpect(status().isNotFound())
                .andExpect(content().string(containsString("not found")));
    }

    @Test
    void invalidJsonIsBadRequest() throws Exception {
        mvc.perform(post(PATH).contentType(MediaType.APPLICATION_JSON).content("{"))
                .andExpect(status().isBadRequest())
                .andExpect(content().string(containsString("invalid JSON body")));
    }

    @Test
    void invalidIdIsBadRequest() throws Exception {
        mvc.perform(get(PATH + "/abc"))
                .andExpect(status().isBadRequest());
    }
