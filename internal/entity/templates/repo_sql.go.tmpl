{{- $d := .P.domain.Name -}}
package {{.P.db.Name}}

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
{{- if .Refs}}
	"strings"
{{- end}}

	"{{.P.domain.Import}}"
)

// {{.E.Name}}Repository stores {{.E.Name}} records in {{.Opt.Database}}.
type {{.E.Name}}Repository struct {
	db *sql.DB
}

func New{{.E.Name}}Repository(db *sql.DB) *{{.E.Name}}Repository {
	return &{{.E.Name}}Repository{db: db}
}

const {{.E.Var}}Columns = "{{.SQL.SelectCols}}"

func scan{{.E.Name}}(row interface{ Scan(...any) error }) ({{$d}}.{{.E.Name}}, error) {
	var x {{$d}}.{{.E.Name}}
	err := row.Scan({{.SQL.ScanArgs}})
	return x, err
}

func (r *{{.E.Name}}Repository) Create(ctx context.Context, in {{$d}}.{{.E.Name}}Input) ({{$d}}.{{.E.Name}}, error) {
{{- if eq .Opt.Database "postgresql"}}
	row := r.db.QueryRowContext(ctx,
		"INSERT INTO {{.E.Table}} ({{.SQL.InsertCols}}) VALUES ({{.SQL.InsertVals}}) RETURNING "+{{.E.Var}}Columns,
		{{.SQL.ExecArgs}})
	x, err := scan{{.E.Name}}(row)
{{- template "refMissing" .}}
	if err != nil {
		return {{$d}}.{{.E.Name}}{}, fmt.Errorf("insert {{.E.Snake}}: %w", err)
	}
	return x, nil
{{- else}}
	res, err := r.db.ExecContext(ctx,
		"INSERT INTO {{.E.Table}} ({{.SQL.InsertCols}}) VALUES ({{.SQL.InsertVals}})",
		{{.SQL.ExecArgs}})
{{- template "refMissing" .}}
	if err != nil {
		return {{$d}}.{{.E.Name}}{}, fmt.Errorf("insert {{.E.Snake}}: %w", err)
	}
	id, err := res.LastInsertId()
	if err != nil {
		return {{$d}}.{{.E.Name}}{}, fmt.Errorf("insert {{.E.Snake}}: %w", err)
	}
	return r.Get(ctx, id)
{{- end}}
}

func (r *{{.E.Name}}Repository) Get(ctx context.Context, id int64) ({{$d}}.{{.E.Name}}, error) {
	x, err := scan{{.E.Name}}(r.db.QueryRowContext(ctx,
		"SELECT "+{{.E.Var}}Columns+" FROM {{.E.Table}} WHERE id = {{.SQL.P1}}", id))
	if errors.Is(err, sql.ErrNoRows) {
		return {{$d}}.{{.E.Name}}{}, {{$d}}.ErrNotFound
	}
	if err != nil {
		return {{$d}}.{{.E.Name}}{}, fmt.Errorf("get {{.E.Snake}}: %w", err)
	}
	return x, nil
}

{{- if .Refs}}
func (r *{{.E.Name}}Repository) List(ctx context.Context, f {{$d}}.{{.E.Name}}Filter, limit, offset int) ([]{{$d}}.{{.E.Name}}, error) {
	var where []string
	var args []any
{{- if eq .Opt.Database "postgresql"}}
	ph := func() string { return fmt.Sprintf("$%d", len(args)) }
{{- else}}
	ph := func() string { return "?" }
{{- end}}
{{- range .Refs}}
	if f.{{.Go}} > 0 {
		args = append(args, f.{{.Go}})
		where = append(where, "{{.Column}} = "+ph())
	}
{{- end}}
	query := "SELECT " + {{.E.Var}}Columns + " FROM {{.E.Table}}"
	if len(where) > 0 {
		query += " WHERE " + strings.Join(where, " AND ")
	}
	args = append(args, limit)
	query += " ORDER BY id LIMIT " + ph()
	args = append(args, offset)
	query += " OFFSET " + ph()
	rows, err := r.db.QueryContext(ctx, query, args...)
{{- else}}
func (r *{{.E.Name}}Repository) List(ctx context.Context, limit, offset int) ([]{{$d}}.{{.E.Name}}, error) {
	rows, err := r.db.QueryContext(ctx,
		"SELECT "+{{.E.Var}}Columns+" FROM {{.E.Table}} ORDER BY id LIMIT {{.SQL.P1}} OFFSET {{.SQL.P2}}", limit, offset)
{{- end}}
	if err != nil {
		return nil, fmt.Errorf("list {{.E.Table}}: %w", err)
	}
	defer rows.Close()
	items := []{{$d}}.{{.E.Name}}{}
	for rows.Next() {
		x, err := scan{{.E.Name}}(rows)
		if err != nil {
			return nil, fmt.Errorf("list {{.E.Table}}: %w", err)
		}
		items = append(items, x)
	}
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("list {{.E.Table}}: %w", err)
	}
	return items, nil
}

func (r *{{.E.Name}}Repository) Update(ctx context.Context, id int64, in {{$d}}.{{.E.Name}}Input) ({{$d}}.{{.E.Name}}, error) {
{{- if eq .Opt.Database "postgresql"}}
	x, err := scan{{.E.Name}}(r.db.QueryRowContext(ctx,
		"UPDATE {{.E.Table}} SET {{.SQL.UpdateSet}}, updated_at = now() WHERE id = {{.SQL.UpdateWhere}} RETURNING "+{{.E.Var}}Columns,
		{{.SQL.ExecArgs}}, id))
{{- template "refMissing" .}}
	if errors.Is(err, sql.ErrNoRows) {
		return {{$d}}.{{.E.Name}}{}, {{$d}}.ErrNotFound
	}
	if err != nil {
		return {{$d}}.{{.E.Name}}{}, fmt.Errorf("update {{.E.Snake}}: %w", err)
	}
	return x, nil
{{- else}}
	_, err := r.db.ExecContext(ctx,
		"UPDATE {{.E.Table}} SET {{.SQL.UpdateSet}} WHERE id = {{.SQL.UpdateWhere}}",
		{{.SQL.ExecArgs}}, id)
{{- template "refMissing" .}}
	if err != nil {
		return {{$d}}.{{.E.Name}}{}, fmt.Errorf("update {{.E.Snake}}: %w", err)
	}
	return r.Get(ctx, id)
{{- end}}
}

func (r *{{.E.Name}}Repository) Delete(ctx context.Context, id int64) error {
	res, err := r.db.ExecContext(ctx, "DELETE FROM {{.E.Table}} WHERE id = {{.SQL.P1}}", id)
	if err != nil {
		if isForeignKeyViolation(err) {
			return fmt.Errorf("%w: other records still refer to this {{.E.Snake}}", {{$d}}.ErrConflict)
		}
		return fmt.Errorf("delete {{.E.Snake}}: %w", err)
	}
	n, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("delete {{.E.Snake}}: %w", err)
	}
	if n == 0 {
		return {{$d}}.ErrNotFound
	}
	return nil
}

{{- define "refMissing"}}
{{- if .Refs}}
	if isForeignKeyViolation(err) {
		// The service checked the ids, but a referred record was deleted since.
		return {{.P.domain.Name}}.{{.E.Name}}{}, fmt.Errorf("%w: a referred record no longer exists", {{.P.domain.Name}}.ErrValidation)
	}
{{- end}}
{{- end}}
